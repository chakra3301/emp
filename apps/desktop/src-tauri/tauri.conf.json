{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EMP",
  "version": "0.1.0",
  "identifier": "com.lucaorion.emp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EMP",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "copyright": "\u00a9 2026 Luca Orion",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/empd"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    },
    "resources": {
      "../dist/": "web/"
    }
  }
}
