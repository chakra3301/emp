{
  "name": "@emp/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "<EmpWorkspace client host /> — host-agnostic EMP UI. Builds as an ESM library (EMP.app) and a single-file ui.html (Orion sandbox).",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/emp-ui.js"
    },
    "./style.css": "./dist/emp-ui.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@emp/client": "0.1.0",
    "@emp/protocol": "0.1.0",
    "marked": "^18.1.1"
  },
  "peerDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "zustand": "^5.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "build": "vite build",
    "build:singlefile": "vite build --config vite.singlefile.config.ts"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
